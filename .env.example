# Copie para .env e preencha as chaves localmente. Não commite o .env.

# Provedor de geração: gemini (padrão), openai ou fake (só testes/offline).
LLM_PROVIDER=gemini
# Provedor de embeddings. fake usa um hashing local, sem rede.
EMBEDDING_PROVIDER=gemini

# Obrigatória se LLM_PROVIDER ou EMBEDDING_PROVIDER for gemini.
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash
# gemini-embedding-001 devolve um vetor por texto. gemini-embedding-2 agrega listas.
GEMINI_EMBEDDING_MODEL=gemini-embedding-001

# Obrigatórias só se o provedor correspondente for openai.
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini
OPENAI_EMBEDDING_MODEL=text-embedding-3-small

# fixed ou recursive. overlap tem de ser menor que chunk_size.
CHUNK_STRATEGY=recursive
CHUNK_SIZE=400
CHUNK_OVERLAP=50

# naive_rag usa TOP_K. rag_rerank recupera RERANK_CANDIDATES e corta em TOP_K.
TOP_K=3
RERANK_CANDIDATES=8

# Caminho do corpus, relativo à raiz do repositório.
CORPUS_PATH=data/sample

# Juiz da avaliação: gemini, openai, fake ou off. off não chama modelo.
# JUDGE_MODEL vazio segue o modelo de geração desse provedor.
JUDGE_PROVIDER=gemini
JUDGE_MODEL=
EVAL_CACHE_DIR=results/cache
PRICE_TABLE=data/eval/prices.v1.json
# Segundos entre chamadas de rede. 6 fica perto de 10 RPM, folgado no tier gratuito.
REQUEST_INTERVAL_S=6
LLM_MAX_RETRIES=6
